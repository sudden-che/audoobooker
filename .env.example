# Скопируйте в .env и заполните значения
# cp .env.example .env

# Режим запуска: web | bot | both
MODE=web

# Telegram-бот (обязательно для режимов bot и both)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Параметры синтеза
VOICE=ru-RU-SvetlanaNeural
SPEED=+18%
CHUNK_SIZE=10000
MAX_CONCURRENT_TASKS=8
MAX_CONCURRENT_REQUESTS=2
MAX_CONCURRENT_UPDATES=4
FORWARD_GROUP_DEBOUNCE_SECONDS=5.0
FFMPEG_PATH=ffmpeg
MERGE_CHUNKS=true
MAX_TEXT_FROM_MESSAGE=50000

# Доставка результата в Telegram:
# telegram  — всегда отправлять файл через Telegram
# send_link — всегда отдавать временную HTTP-ссылку
# auto      — отправлять через Telegram, а большие файлы отдавать ссылкой
DELIVERY_MODE=auto
TELEGRAM_SAFE_UPLOAD_BYTES=51380224
DOWNLOAD_DIR=/app/data/downloads
DOWNLOAD_TTL_SECONDS=900
# Если заданы минуты, они имеют приоритет над DOWNLOAD_TTL_SECONDS.
DOWNLOAD_TTL_MINUTES=15
DOWNLOAD_SERVER_HOST=0.0.0.0
DOWNLOAD_SERVER_PORT=43561
DOWNLOAD_SERVER_IDLE_GRACE_SECONDS=5
PUBLIC_DOWNLOAD_BASE_URL=http://server.example.org:43561

# Тег [[PAUSE: 5000]] добавляет 5000 мс тишины.
# Имя PAUSE не зависит от регистра, пробелы необязательны.
MAX_PAUSE_MS=600000
MAX_TOTAL_PAUSE_MS=3600000

# Веб-сервер
WEB_HOST=0.0.0.0
WEB_PORT=8000
